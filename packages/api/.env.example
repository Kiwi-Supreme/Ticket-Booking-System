# API environment — copy to packages/api/.env and fill in.
DATABASE_URL="postgresql://ticket:ticket@localhost:5433/ticketing?schema=public"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-secret"
CORS_ORIGIN="http://localhost:5173"
APP_BASE_URL="http://localhost:5173"

# Seat hold + waitlist offer lifetimes (seconds) and sweeper cadence.
HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=600
SWEEP_INTERVAL_SECONDS=15

# Email via Resend. Leave RESEND_API_KEY blank in dev to use the Ethereal preview transport.
RESEND_API_KEY=""
MAIL_FROM="Ticket Booking <onboarding@resend.dev>"
